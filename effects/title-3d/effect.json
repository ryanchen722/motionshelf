{
  "name": "3D 轉動字卡",
  "name_en": "3D turning title",
  "category": "3D",
  "duration": 4,
  "fps": 30,
  "params": [
    { "key": "text",       "type": "text",   "label": "文字",     "label_en": "Text",        "default": "MotionShelf" },
    { "key": "font",       "type": "font",   "label": "字體",     "label_en": "Font",        "default": "Helvetica Neue" },
    { "key": "color",      "type": "color",  "label": "正面顏色", "label_en": "Face color",  "default": "#FFFFFF" },
    { "key": "sideColor",  "type": "color",  "label": "側面顏色", "label_en": "Side color",  "default": "#FF5A36" },
    { "key": "size",       "type": "number", "label": "字級",     "label_en": "Size",        "default": 220, "min": 60, "max": 400, "step": 1 },
    { "key": "weight",     "type": "number", "label": "粗細",     "label_en": "Weight",      "default": 800, "min": 100, "max": 900, "step": 100 },
    { "key": "depth",      "type": "number", "label": "厚度",     "label_en": "Depth",       "default": 60, "min": 0, "max": 200, "step": 1 },
    { "key": "axis",       "type": "select", "label": "轉動方向", "label_en": "Turn axis",   "default": "左右",
      "options": ["左右", "上下"], "options_en": ["Left-right", "Up-down"] },
    { "key": "startAngle", "type": "number", "label": "起始角度", "label_en": "Start angle", "default": 70, "min": -90, "max": 90, "step": 1 },
    { "key": "endAngle",   "type": "number", "label": "結束角度", "label_en": "End angle",   "default": -25, "min": -90, "max": 90, "step": 1 },
    { "key": "persp",      "type": "number", "label": "透視強度", "label_en": "Perspective", "default": 1, "min": 0.4, "max": 2.5, "step": 0.1 },
    { "key": "delay",      "type": "number", "label": "開始時間", "label_en": "Start time",  "default": 0.3, "min": 0, "max": 2, "step": 0.1 },
    { "key": "turn",       "type": "number", "label": "轉動時間", "label_en": "Turn time",   "default": 2, "min": 0.3, "max": 3.5, "step": 0.1 }
  ],
  "check": { "time": 2.5, "params": { "text": "Hello", "sideColor": "#3D5AFE" } }
}
