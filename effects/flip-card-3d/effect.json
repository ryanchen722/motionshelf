    },
    {
      "key": "back",
      "type": "text",
      "label": "背面文字",
      "label_en": "Back text",
      "default": "BACK"
    },
    {
      "key": "font",
      "type": "font",
      "label": "字體",
      "label_en": "Font",
      "default": "Helvetica Neue"
    },
    {
      "key": "cardColor",
      "type": "color",
      "label": "正面底色",
      "label_en": "Front color",
      "default": "#FF5A36"
    },
    {
      "key": "backColor",
      "type": "color",
      "label": "背面底色",
      "label_en": "Back color",
      "default": "#1F2A44"
    },
    {
      "key": "textColor",
      "type": "color",
      "label": "文字顏色",
      "label_en": "Text color",
      "default": "#FFFFFF"
    },
    {
      "key": "size",
      "type": "number",
      "label": "字級",
      "label_en": "Size",
      "default": 200,
      "min": 60,
      "max": 360,
      "step": 1
