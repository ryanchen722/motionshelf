    {
      "key": "turn",
      "type": "number",
      "label": "翻轉時間",
      "label_en": "Turn time",
      "default": 2,
      "min": 0.4,
      "max": 3.5,
      "step": 0.1
    },
    {
      "key": "persp",
      "type": "number",
      "label": "透視強度",
      "label_en": "Perspective",
      "default": 1,
      "min": 0.4,
      "max": 2.5,
      "step": 0.1
